  "repository": "https://github.com/JuicedSystems/claude-gsc-multi-site",
  "license": "MIT",
  "keywords": ["google-search-console", "gsc", "seo", "search-analytics", "multi-site", "mcp"],
  "mcpServers": {
    "gsc-multi-site": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.js"]
    }
  }
